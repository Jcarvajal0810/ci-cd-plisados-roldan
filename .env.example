# Copy to .env and choose your own values. .env is git-ignored: never commit real secrets.

# Database component
DB_NAME=plisados
DB_USER=plisados
DB_PASSWORD=change-me

# First admin account, created by the backend only when no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Public address of the site (sitemap and link previews)
PUBLIC_BASE_URL=http://localhost:4000

# Host names the frontend's SSR server accepts (comma separated); add your domain when deployed
NG_ALLOWED_HOSTS=localhost,127.0.0.1
