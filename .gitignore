# ---------------------------------------------------------------- secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
credentials*.json
secrets/

# ---------------------------------------------------------------- uploaded images (runtime data)
media/

# ---------------------------------------------------------------- backend (Java / Maven)
backend/target/
*.class
*.log
hs_err_pid*
**/.mvn/wrapper/maven-wrapper.jar

# ---------------------------------------------------------------- frontend (Node / Angular)
node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
frontend/out-tsc/
