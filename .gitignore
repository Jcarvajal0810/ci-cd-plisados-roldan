# ---------------------------------------------------------------- local tool settings
.claude/settings.local.json
.claude/worktrees/
.idea/
*.iml
**/.vscode/*
!**/.vscode/extensions.json
.history/

# ---------------------------------------------------------------- OS files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp


