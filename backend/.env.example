# Only for running the backend outside Docker (./mvnw spring-boot:run). Copy to backend/.env.
# Start the database component first, from the project root:  docker compose up -d db db-migrate
DB_URL=jdbc:postgresql://localhost:5432/plisados
DB_USER=plisados
DB_PASSWORD=change-me

# First admin, created only when no admin exists (research R6)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Image storage directory (research R8)
MEDIA_ROOT=./media

# Absolute base URL used in the sitemap and Open Graph tags
PUBLIC_BASE_URL=http://localhost:4200
